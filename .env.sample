# Application Environment
ENVIRONMENT=development
APP_NAME="CustomScape SAM Image Segmentation"
LOG_LEVEL=info

# AWS S3 Configuration
MASK_BUCKET_NAME=your-s3-bucket-name

# AWS SQS Configuration
SQS_QUEUE_URL=https://sqs.xxxx.amazonaws.com/123456789012/my-queue

# Application Server
APP_SERVER_URL=https://your-app-server.com

# AWS Credentials
AWS_REGION=your-aws-region
AWS_PROFILE=your-aws-profile

# SAM Model Path
SAM_MODEL_PATH=models/weights/sam_vit_h.pth
SAM_MODEL_S3_URL=https://your-s3-bucket-name.s3.your-region.amazonaws.com/sam_vit_h.pth

# App server configuration
BASE_URL=http://localhost:8000
APP_SERVER_API_KEY=your-api-key